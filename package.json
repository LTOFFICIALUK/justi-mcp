{
  "name": "@justifun/mcp",
  "version": "0.1.0",
  "description": "MCP server for justi.fun, a fair Solana launchpad on Meteora. Lets AI agents list and search coins, read coin details, quote, and build unsigned swap and launch transactions.",
  "keywords": [
    "mcp",
    "model context protocol",
    "solana",
    "launchpad",
    "token launch",
    "memecoin",
    "meteora",
    "justi.fun",
    "ai agent",
    "claude",
    "cursor"
  ],
  "homepage": "https://docs.justi.fun",
  "license": "MIT",
  "type": "module",
  "bin": {
    "justi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
